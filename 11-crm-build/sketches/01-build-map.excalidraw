   "versionNonce": 1544064017,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1789714290706,
   "link": null,
   "locked": false,
   "text": "One square per stage, in order. The number is how many things to build there — darker means more.\nEmber dot: something that exists needs fixing. Dashed: the whole stage waits on a Prospa decision. Empty: nothing to build.",
   "fontSize": 9.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "One square per stage, in order. The number is how many things to build there — darker means more.\nEmber dot: something that exists needs fixing. Dashed: the whole stage waits on a Prospa decision. Empty: nothing to build.",
   "autoResize": true,
   "lineHeight": 1.25
  },
